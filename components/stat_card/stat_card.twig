{% set attributes = attributes.addClass(["su-stat-card", "su-card"]) %}
{% set isArticle = headline|render_clean is not empty %}

<{{ isArticle ? "article" : "div" }}{{ attributes }}>
{% if image %}
  <div class="stat-card-image">{{ image }}</div>
{% endif %}
<div class="su-card__contents">
  {% if headline or super_headline or stat %}
    <div class="stat-card-header">
      {% if headline %}
        <div class="stat-card-headline">{{ headline }}</div>
      {% endif %}
      {% if stat %}
        <div class="stat-card-stat">{{ stat }}</div>
      {% endif %}
      {% if super_headline %}
        <div class="stat-card-super-headline">{{ super_headline }}</div>
      {% endif %}
      {% if icon %}
        <div class="stat-card-icon">{{ icon }}</div>
      {% endif %}
    </div>
  {% endif %}
  {% if body %}
    <div class="stat-card-body">{{ body }}</div>
  {% endif %}
  {% if link %}
    <div class="stat-card-link">{{ link }}</div>
  {% endif %}
</div>
</{{ isArticle ? "article" : "div" }}>
