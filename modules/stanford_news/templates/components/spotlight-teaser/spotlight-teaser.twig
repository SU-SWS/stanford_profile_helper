{#
/**
 * @file
 * Spotlight Teaser.
 *
 * Spotlight Teaser for News
 *
 * Available variables:
 * - attributes: For additional HTML attributes not already provided.
 * - spotlight_teaser_headline: Title of news
 * - spotlight_teaser_quote: Quote/Big Text field
 * - spotlight_teaser_media: Featured media image
 * - spotlight_filters: Spotlight filter terms
 * - date: Publication date
 */
#}

{%-
  set classes = [
    'su-card',
    'su-spotlight-teaser',
    modifier_class
  ]
-%}

<article{{attributes.addClass(classes)}}>
	<figure class="su-media su-media--image su-card__media">
		<div class="su-media__wrapper">
			{{- spotlight_teaser_media|render -}}
		</div>
	</figure>
	<div class="su-card__contents">

		{% if spotlight_teaser_headline is not empty %}
			<div class="su-news-header su-spotlight-teaser__link">
				{{- spotlight_teaser_headline|render -}}
			</div>
		{% endif %}

		{% if date is not empty %}
			<div class="su-news-date">
				{{- date|render -}}
			</div>
		{% endif %}

		{% if spotlight_filters is not empty %}
			<div class="su-spotlight-teaser__topics">
				{{- spotlight_filters|render -}}
			</div>
		{% endif %}

		{% if spotlight_teaser_quote is not empty %}
			<div class="su-spotlight-teaser__quote">
				{{- spotlight_teaser_quote|render -}}
			</div>
		{% endif %}

	</div>
</article>
