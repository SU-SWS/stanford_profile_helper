{#
/**
 * @file
 * Course List teaser.
 *
 * Basic list item for courses.
 *
 * Available variables:
 * - attributes: For additional HTML attributes not already provided.
 * - code
 * - academic_year
 * - quarters
 * - title
 * - instructors
 * - description
 * - url
 *
 */
#}
{%- set attributes = attributes.addClass(['su-course-list-item', modifier_class]) -%}

<article{{ attributes }}>

  <div class="su-course-list__title">
    {%- if url -%}
    <a href="{{ url }}">
      {%- endif -%}

      {% if title %}
      <{{ header_tag|default('h2') }} id="{{ headingID }}">
      {{- title -}}
    </{{ header_tag|default('h2') }}>
    {% endif %}

    {%- if url -%}
      </a>
    {%- endif -%}
  </div>

  {%- if code|render_clean is not empty or academic_year|render_clean is not empty -%}
    <header class="su-course-list__header">
      {%- if code|render_clean is not empty -%}
        <strong>{{ code|render|striptags|replace({'\n': ''})|raw }}</strong>{%- endif -%}
      {%- if code|render_clean is not empty and academic_year|render_clean  is not empty -%} &nbsp;|{%- endif -%}
      {%- if academic_year|render_clean is not empty -%}{{ academic_year }}{%- endif -%}
      {%- if quarters is not empty -%}{{ quarters }}{%- endif -%}
    </header>
  {%- endif -%}

  {%- if instructors|render|striptags('<drupal-render-placeholder>')|trim is not empty -%}
    <div class="su-course-list__instructors">
      <span class="instructor-label">Instructors: </span>{{ instructors }}
    </div>
  {%- endif -%}

  {%- if description|render|striptags('<drupal-render-placeholder>')|trim is not empty -%}
    <div class="su-course-list__description">
      {{ description }}
    </div>
  {%- endif -%}


</article>
